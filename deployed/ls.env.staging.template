# LeagueSphere Staging Environment Variables
# This is a template file - copy to ls.env.staging and fill in actual values

# MySQL Configuration (staging-specific database)
MYSQL_HOST=mysql
MYSQL_DB_NAME=leaguesphere_staging
MYSQL_USER=leaguesphere_staging
MYSQL_PWD=<GENERATE_SECURE_PASSWORD>
MYSQL_ROOT_PASSWORD=<GENERATE_SECURE_ROOT_PASSWORD>

# Django Settings
SECRET_KEY=<GENERATE_DJANGO_SECRET_KEY>

# Moodle Integration (can reuse production credentials or create staging-specific)
MOODLE_URL='https://offd.de'
MOODLE_WSTOKEN='<MOODLE_TOKEN>'

# Equipment Approval Service
APPROVAL_ENDPOINT='https://script.google.com/macros/s/AKfycbyw_lO3Nq_qiGS7TbmalhV4vOu9JdsWJxIlfNf845wiOZJf1IUf7jGMMbee8VHNqr1yKg/exec'
APPROVAL_TOKEN='<APPROVAL_TOKEN>'

# Temporary database access (dbaccess) - the app half of the db-access sidecar.
# DBACCESS_SECRET_KEY must be a Fernet key; rotation only affects credentials
# already handed out (they become unreadable, not invalid).
DBACCESS_ENABLED=true
DBACCESS_SECRET_KEY='<FERNET_KEY>'
DBACCESS_TTL_CAP_HOURS=8

# Scorecard event store (see docs/topics/guides/scorecard-events-operations.md).
# false = the liveticker keeps reading TeamLog while events accumulate behind it.
# Flip to true only after `manage.py check_game_projection --all` is green on
# this environment.
SCORECARD_EVENT_FEED=false
