{
  "name": "scorecard-v2",
  "version": "5.2.4",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "watch": "vite build --watch",
    "test": "vitest",
    "test:run": "vitest run --coverage",
    "eslint": "eslint ./src",
    "eslint:junit": "eslint ./src --format junit -o /tmp/eslint/js-lint-results-scorecard-v2.xml",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "idb": "8.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.9.1",
    "eslint-formatter-junit": "9.0.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.6",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
