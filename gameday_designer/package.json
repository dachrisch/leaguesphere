{
  "name": "gameday_designer",
  "version": "5.8.3",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "dependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axios": "1.21.0",
    "i18next": "26.6.0",
    "i18next-browser-languagedetector": "8.2.4",
    "i18next-resources-to-backend": "1.2.3",
    "react": "19.3.1",
    "react-bootstrap": "2.10.10",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.10",
    "react-joyride": "^3.2.0",
    "react-router-dom": "7.18.5",
    "react-select": "5.10.2",
    "uuid": "14.0.3",
    "web-vitals": "6.2.3"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "watch": "vite build --watch",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "eslint": "eslint ./src",
    "eslint:junit": "eslint ./src --format junit -o /tmp/eslint/js-lint-results-gameday_designer.xml",
    "eslint:json": "eslint ./src --format json -o js-lint-results-gameday_designer.json",
    "dev": "vite build",
    "i18n:types": "i18next-resources-for-ts toc -i ./src/i18n/locales/de -o ./src/i18n/types.d.ts",
    "prebuild": "npm run i18n:types"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-transform-private-property-in-object": "8.0.5",
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react-router-dom": "5.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "esbuild": "^0.28.0",
    "eslint": "10.14.0",
    "eslint-formatter-junit": "9.0.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "i18next-resources-for-ts": "2.1.2",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "postcss": "8.5.32",
    "nth-check": "3.0.1",
    "serialize-javascript": "7.1.4",
    "debug": "4.4.3",
    "xml2js": "0.6.2",
    "typescript": "$typescript",
    "typescript-eslint": {
      "eslint": "^10.0.0"
    },
    "eslint-plugin-react-hooks": {
      "eslint": "^10.0.0"
    },
    "vite": "$vite"
  }
}
