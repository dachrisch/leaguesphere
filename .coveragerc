# .coveragerc to control coverage.py
[run]
source = .
branch = True
# Phase 3 frontend harness is covered by its own pytest run and branch gate
# (scripts/equivalence/frontend/README.md), not by the Python shards.
omit =
   *venv/*
   *venv/bin/*
   *venv/include/*
   *venv/lib/*
   *manage.py
   */settings.py
   */fixtures/*
   */static/*
   */templates/*
   */tests/*
   *apps.py
   */migrations/*
   */wsgi.py
   */asgi.py
   */urls.py

   # Phase 3 frontend harness: covered by its own pytest run and branch gate
   # (see scripts/equivalence/frontend/README.md), not by the Python shards.
   scripts/equivalence/frontend/*
   *__init__*
   */__pycache__/*
   */site-packages/*
   */distutils/*


[report]
#fail_under = 80
show_missing = True
#skip_covered = True
