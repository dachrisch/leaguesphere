# copy and rename this file to .env
# set needed keys appropriately
MYSQL_DB_NAME=5erdffl$league_manager
MYSQL_USER=root
MYSQL_PWD=root
MYSQL_HOST=localhost
MOODLE_URL='https://moodle.url'
MOODLE_WSTOKEN='wstoken'
SECRET_KEY=https://djecrety.ir/
EQUIPMENT_APPROVAL_ENDPOINT='https://some-json.endpoint'
EQUIPMENT_APPROVAL_TOKEN=MatchingTokenFromEndpoint
# Temporary database access (dbaccess). The key protects the credential that is
# revealed once in the UI; generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DBACCESS_ENABLED=false
DBACCESS_SECRET_KEY=
DBACCESS_TTL_CAP_HOURS=8
# Read the liveticker's score/period from the scorecard event projection.
SCORECARD_EVENT_FEED=false
# Page-cache TTL for the liveticker feed. Keep at 60 until the k6 run on stage
# has measured a lower value.
LIVETICKER_CACHE_SECONDS=60
# Serve /liveticker/v2/ links and the menu entry from the v2 app.
LIVETICKER_V2_ENABLED=false
# Server-Sent-Events stream for the v2 ticker (needs the liveticker-stream
# container behind nginx). Off keeps the client on the 60 s poll.
LIVETICKER_STREAM_ENABLED=false
LIVETICKER_STREAM_POLL_SECONDS=1.0
LIVETICKER_STREAM_HEARTBEAT_SECONDS=15
LIVETICKER_STREAM_MAX_CLIENTS=2000
LIVETICKER_STREAM_MAX_TICK_FAILURES=10
